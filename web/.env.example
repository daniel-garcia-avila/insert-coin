# Copia este archivo como .env y rellena los valores.
# Firebase: Configuración del proyecto > General > Tus apps > Configuración del SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=

# URL de tu backend en Cloudflare (la que muestra "npx wrangler deploy")
VITE_API_URL=https://insert-coin-api.TU-SUBDOMINIO.workers.dev

# Pon 1 para probar la app sin configurar nada (datos de ejemplo en este navegador)
VITE_DEMO=0
