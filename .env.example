# Copia este archivo como .env.local y rellena los valores.
# ⚠️ Nunca subas .env.local a Git (ya está en .gitignore).

# Contraseña única para entrar en la app (mínimo 8 caracteres)
APP_PASSWORD=cambia-esta-contraseña

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios)
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Supabase → Project Settings → API (Data API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_...)
# o, en proyectos antiguos, la clave "service_role". SOLO servidor.
SUPABASE_SECRET_KEY=

# --- Fase 2: identificación con IA (Google Gemini, plan gratuito) ---
# Crea la clave en https://aistudio.google.com → Get API key. SOLO servidor.
# Si la dejas vacía, la app funciona pero sin identificación automática.
GEMINI_API_KEY=
# Opcional: modelos a usar (si el principal se queda sin cuota, se usa el de reserva)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Fase 3: tasación ---
# Opcional. Clave gratuita de la API de Numista (≈2.000 llamadas/mes): https://es.numista.com/api/index.php
# Con ella se usan precios de catálogo por estado; sin ella, la IA (Gemini) hace una estimación orientativa.
NUMISTA_API_KEY=
